# ============================================================
# 邀约宝后端 - Nginx 反向代理配置示例
# 适用：Windows Server + Nginx for Windows
# 路径：D:\nginx\conf\nginx.conf
# ============================================================
#
# 使用方法：
#   1. 下载 Nginx for Windows: https://nginx.org/en/download.html
#   2. 解压到 D:\nginx
#   3. 将本文件内容替换 D:\nginx\conf\nginx.conf
#   4. 将 SSL 证书放到 D:\nginx\conf\certs\ 目录
#   5. 运行: D:\nginx\nginx.exe
#
# 常用命令：
#   D:\nginx\nginx.exe -t          # 检查配置语法
#   D:\nginx\nginx.exe -s reload  # 重载配置
#   D:\nginx\nginx.exe -s stop    # 停止服务
#
# ============================================================

worker_processes  1;

error_log  logs/error.log;
pid        logs/nginx.pid;

events {
    worker_connections  1024;
}

http {
    include       mime.types;
    default_type  application/octet-stream;

    # 日志格式
    log_format  main  '$remote_addr - $remote_user [$time_local] "$request" '
                      '$status $body_bytes_sent "$http_referer" '
                      '"$http_user_agent" "$http_x_forwarded_for"';

    access_log  logs/access.log  main;

    # 基础优化
    sendfile        on;
    tcp_nopush      on;
    tcp_nodelay     on;
    keepalive_timeout  65;
    types_hash_max_size 2048;

    # 上传文件大小限制（支持 Excel 导入）
    client_max_body_size  20m;

    # Gzip 压缩
    gzip  on;
    gzip_vary  on;
    gzip_proxied  any;
    gzip_comp_level  6;
    gzip_types  text/plain text/css text/xml application/json
                application/javascript application/xml application/xml+rss;

    # =============================================
    # 默认 HTTP 服务器（80 端口）
    # 自动跳转到 HTTPS
    # =============================================
    server {
        listen       80;
        server_name  localhost api.yaoyuebao.cn yaoyuebao.cn;

        # 强制跳转到 HTTPS（注释掉下面一行可临时关闭跳转用于测试）
        return  301 https://$host$request_uri;
    }

    # =============================================
    # HTTPS 服务器（443 端口）
    # =============================================
    server {
        listen       443 ssl;
        server_name  api.yaoyuebao.cn yaoyuebao.cn;

        # ---------- SSL 证书配置 ----------
        # ⚠️ 请将 YOUR_DOMAIN 替换为实际域名
        # ⚠️ 证书文件路径必须是绝对路径（Windows 用正斜杠）
        ssl_certificate      D:/nginx/conf/certs/YOUR_DOMAIN.pem;
        ssl_certificate_key  D:/nginx/conf/certs/YOUR_DOMAIN.key;

        # SSL 安全配置（Modern 级别）
        ssl_protocols        TLSv1.2 TLSv1.3;
        ssl_ciphers          ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;
        ssl_prefer_server_ciphers  on;
        ssl_session_cache    shared:SSL:10m;
        ssl_session_timeout  1d;

        # 安全头
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header X-Frame-Options        "SAMEORIGIN"   always;
        add_header X-Content-Type-Options  "nosniff"      always;
        add_header X-XSS-Protection        "1; mode=block" always;

        # 日志
        access_log  logs/ssl_access.log  main;
        error_log   logs/ssl_error.log;

        # ---------- 反向代理到后端 ----------
        location / {
            proxy_pass         http://127.0.0.1:8000;
            proxy_http_version 1.1;

            # 转发真实 IP（重要！否则后端看到的是 Nginx IP）
            proxy_set_header   Host              $host;
            proxy_set_header   X-Real-IP         $remote_addr;
            proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
            proxy_set_header   X-Forwarded-Proto  $scheme;

            # 超时设置
            proxy_connect_timeout  60s;
            proxy_read_timeout     60s;
            proxy_send_timeout     60s;

            # 上传大文件支持
            client_max_body_size   20m;
            proxy_request_buffering off;
        }

        # ---------- API 文档（Swagger UI）----------
        location /docs {
            proxy_pass  http://127.0.0.1:8000/docs;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
        }

        location /openapi.json {
            proxy_pass  http://127.0.0.1:8000/openapi.json;
            proxy_set_header Host $host;
        }

        # ---------- 静态文件（扩展用）----------
        # 如果后端有 /static 路由代理到这里
        location /static/ {
            proxy_pass  http://127.0.0.1:8000/static/;
            proxy_set_header Host $host;
            expires     30d;
            add_header  Cache-Control "public, immutable";
        }

        # ---------- 根路径 ----------
        location = / {
            proxy_pass  http://127.0.0.1:8000/;
            proxy_set_header Host $host;
        }
    }
}
