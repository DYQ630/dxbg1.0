# ============================================================
# 邀约宝后端 - 生产环境变量示例
# 使用方法：复制为同目录的 .env 并填入真实值
#   cp .env.example .env
#   nano .env        # 修改 SECRET_KEY / DB_PATH 等
# ⚠️ .env 含敏感信息（SECRET_KEY），切勿提交到 git（已被 .gitignore 忽略）
# 本文件字段与已改造的源码严格对应（见 auth.py / database.py 的 os.environ.get）
# ============================================================

# ---------- 数据库路径（✅ 已生效） ----------
# 对应 database.py 中：DB_PATH = os.environ.get("DB_PATH", <默认 app/dialer.db>)
# SQLite 单文件绝对路径；建议放在独立数据目录，便于每日备份与权限隔离
DB_PATH=/var/lib/yaoyuebao/dialer.db

# ---------- JWT 签名密钥（✅ 已生效，必须改！） ----------
# 对应 auth.py 中：SECRET = os.environ.get("SECRET_KEY", <开发默认值>)
# 生成命令（二选一）：
#   openssl rand -hex 32
#   python -c "import secrets; print(secrets.token_hex(32))"
# ⚠️ 上线前必须改为随机值；一旦修改，所有已签发 Token 立即失效（用户需重新登录）
SECRET_KEY=change_me_to_a_random_32_char_secret_key

# ---------- 服务模式（✅ 已生效） ----------
# production：关闭调试信息；development：启用热重载与详细日志
ENV=production

# ---------- 以下为预留字段（⚠️ 当前代码未读取，保留以便未来扩展） ----------
# main.py 的 CORS 白名单已在第一优先级硬编码为正式域名，故 CORS_ORIGINS 暂不生效
# CORS_ORIGINS=https://yaoyuebao.cn,https://api.yaoyuebao.cn
# API 端口由 systemd / gunicorn 命令行 -b 127.0.0.1:8000 指定，故 API_PORT 暂不生效
# API_PORT=8000
