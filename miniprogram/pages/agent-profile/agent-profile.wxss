/* ============================================================
   邀约员 · 个人资料
   ============================================================ */

/* 顶部渐变用户卡 */
.profile-card {
  background: var(--gradient);
  border-radius: 32rpx;
  padding: 48rpx 40rpx;
  margin-bottom: 24rpx;
  display: flex;
  align-items: center;
  color: #fff;
  box-shadow: 0 8rpx 28rpx rgba(155, 126, 222, 0.3);
}
.profile-card .avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.28);
  color: #fff;
  font-size: 52rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  border: 4rpx solid rgba(255, 255, 255, 0.6);
}
.profile-card .p-info {
  flex: 1;
  min-width: 0;
  margin-left: 28rpx;
}
.profile-card .p-name {
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}
.profile-card .p-sub {
  font-size: 24rpx;
  opacity: 0.85;
  margin-top: 8rpx;
}
.profile-card .role-badge {
  background: rgba(255, 255, 255, 0.25);
  border-radius: 24rpx;
  padding: 8rpx 20rpx;
  font-size: 22rpx;
  flex-shrink: 0;
}

/* 列表行 */
.list-item .name { font-size: 30rpx; font-weight: 500; color: var(--text); }
.list-item .name.logout { color: var(--danger); }
.list-item .arrow {
  font-size: 40rpx;
  color: #C9C4D4;
  line-height: 1;
}
