/* ============================================================
   登录页 · 粉紫渐变主题
   页面整体铺满渐变背景，中间白色表单卡片
   ============================================================ */
/* 页面容器：全屏渐变背景，垂直居中 */
.login-page {
  min-height: 100vh;
  background: linear-gradient(135deg, #FF6B9D 0%, #9B7EDE 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx 40rpx;
}
/* 顶部品牌区：图标 + 应用名 + 副标题 */
.login-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 80rpx;
}
.logo-icon {
  width: 180rpx;
  height: 180rpx;
  border-radius: 44rpx;
  box-shadow: 0 16rpx 40rpx rgba(0, 0, 0, 0.22);
  margin-bottom: 32rpx;
  background: #fff;
}
.app-name {
  font-size: 48rpx;
  font-weight: 600;
  color: #fff;
  margin-bottom: 8rpx;
}
.app-sub {
  font-size: 26rpx;
  color: rgba(255,255,255,0.8);
}
/* 登录表单卡片 */
.login-form {
  width: 100%;
  max-width: 600rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 48rpx 40rpx;
  box-shadow: 0 8rpx 32rpx rgba(0,0,0,0.12);
}
/* 单个表单项 */
.form-item {
  margin-bottom: 32rpx;
}
.form-label {
  font-size: 26rpx;
  color: var(--text-sub, #8E8AA0);
  margin-bottom: 12rpx;
}
.form-input {
  height: 88rpx;
  background: var(--bg, #FAF7FB);
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
}
/* 输入框占位符颜色 */
.placeholder {
  color: #C0B8C8;
}
/* 登录按钮：渐变胶囊形 */
.login-btn {
  width: 100%;
  height: 88rpx;
  background: linear-gradient(135deg, #FF6B9D, #9B7EDE);
  color: #fff;
  font-size: 32rpx;
  font-weight: 500;
  border-radius: 44rpx;
  border: none;
  margin-top: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
/* 登录中：按钮半透明 */
.login-btn[disabled] {
  opacity: 0.6;
}
/* 底部版本信息 */
.login-footer {
  margin-top: 60rpx;
}
.login-footer .text-sub {
  color: rgba(255,255,255,0.6);
  font-size: 24rpx;
}
