/* ============================================================
   邀约宝 · 全局样式 v2（小红书 / 得物 粉紫渐变主题）
   主色 #FF6B9D（粉） · 辅色 #9B7EDE（紫）
   背景 #FAF7FB · 文字 #2D2A3F / #8E8AA0
   ============================================================ */

page {
  /* ---- 设计变量 ---- */
  --primary: #FF6B9D;
  --secondary: #9B7EDE;
  --gradient: linear-gradient(135deg, #FF6B9D 0%, #9B7EDE 100%);
  --bg: #FAF7FB;
  --text: #2D2A3F;
  --text-sub: #8E8AA0;
  --border: #F0EDF2;
  --success: #67C23A;
  --warning: #E6A23C;
  --danger: #F56C6C;
  --info: #5B8FF9;

  background-color: var(--bg);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", "Helvetica Neue", Helvetica, sans-serif;
  font-size: 28rpx;
  color: var(--text);
  box-sizing: border-box;
  -webkit-font-smoothing: antialiased;
}

view,
text,
button,
input,
textarea,
scroll-view {
  box-sizing: border-box;
}

/* ---------- 文字颜色工具 ---------- */
.theme-primary { color: var(--primary); }
.theme-secondary { color: var(--secondary); }
.text-sub { color: var(--text-sub); font-size: 24rpx; }
.text-success { color: var(--success); }
.text-danger { color: var(--danger); }
.text-warning { color: var(--warning); }
.text-info { color: var(--info); }
.bg-primary { background-color: var(--primary); }
.bg-secondary { background-color: var(--secondary); }
.bg-gradient { background: var(--gradient); }

/* ---------- 页面容器 ---------- */
.page {
  min-height: 100vh;
  padding: 24rpx 32rpx;
  padding-bottom: 160rpx;
  background: var(--bg);
}

/* ---------- 顶部渐变导航条（沉浸式） ---------- */
.header-bar {
  position: relative;
  min-height: 200rpx;
  background: var(--gradient);
  padding: 64rpx 32rpx 40rpx;
  margin: -24rpx -32rpx 32rpx;
  border-radius: 0 0 48rpx 48rpx;
  box-shadow: 0 8rpx 24rpx rgba(155, 126, 222, 0.18);
  color: #fff;
  padding-top: max(64rpx, env(safe-area-inset-top));
}
.header-bar h1,
.header-bar .title {
  font-size: 40rpx;
  font-weight: 700;
  color: #fff;
  letter-spacing: 1rpx;
}
.header-bar .sub,
.header-bar .subtitle {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-top: 8rpx;
}
.header-bar .progress-bar {
  height: 12rpx;
  background: rgba(255, 255, 255, 0.3);
  border-radius: 6rpx;
  overflow: hidden;
  margin-top: 24rpx;
}
.header-bar .progress-bar .fill {
  height: 100%;
  background: #fff;
  border-radius: 6rpx;
  transition: width 0.3s;
}

/* ---------- 卡片 ---------- */
.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(255, 107, 157, 0.08);
}
.card-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 24rpx;
  color: var(--text);
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.card-title .more {
  font-size: 24rpx;
  font-weight: 400;
  color: var(--primary);
}

/* ---------- 统计网格 ---------- */
.stat-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}
.stat-item {
  flex: 1;
  min-width: 140rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx 16rpx;
  text-align: center;
  box-shadow: 0 4rpx 20rpx rgba(255, 107, 157, 0.06);
}
.stat-item .num {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--primary);
  line-height: 1.2;
}
.stat-item .num.text-success { color: var(--success); }
.stat-item .num.text-danger { color: var(--danger); }
.stat-item .num.theme-secondary { color: var(--secondary); }
.stat-item .label {
  font-size: 22rpx;
  color: var(--text-sub);
  margin-top: 8rpx;
}

/* 旧网格工具（保留，兼容未改动的页面） */
.grid-2 { display: flex; gap: 24rpx; }
.grid-2 > view { flex: 1; }
.grid-3 { display: flex; gap: 20rpx; }
.grid-3 > view { flex: 1; }
.grid-4 { display: flex; gap: 16rpx; }
.grid-4 > view { flex: 1; }
.stat-box {
  background: linear-gradient(135deg, #FFF0F5 0%, #F5F0FF 100%);
  border-radius: 20rpx;
  padding: 28rpx 16rpx;
  text-align: center;
}
.stat-box .num { font-size: 44rpx; font-weight: 700; color: var(--primary); }
.stat-box .label { font-size: 22rpx; color: var(--text-sub); margin-top: 8rpx; }
.stat-box .icon { font-size: 56rpx; margin-bottom: 8rpx; }
.stat-box.tappable:active { opacity: 0.85; }

/* ---------- 标签药丸 ---------- */
.tag-chip {
  display: inline-block;
  padding: 12rpx 24rpx;
  border-radius: 36rpx;
  font-size: 26rpx;
  margin: 8rpx 10rpx 8rpx 0;
  background: #F5F5F7;
  color: var(--text);
  border: 2rpx solid transparent;
  transition: all 0.2s;
  line-height: 1.3;
}
.tag-chip.selected {
  background: var(--c, var(--primary));
  color: #fff;
  border-color: var(--c, var(--primary));
}
.tag-wrap { display: flex; flex-wrap: wrap; }

/* ---------- 角标 ---------- */
.badge {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 16rpx;
  font-size: 22rpx;
  margin-right: 8rpx;
  line-height: 1.5;
}
.badge-success { background: #E1F3D8; color: var(--success); }
.badge-warning { background: #FAECD8; color: var(--warning); }
.badge-danger { background: #FDE2E2; color: var(--danger); }
.badge-info { background: #E8F0FE; color: var(--info); }
.badge-purple { background: #F0E6FF; color: var(--secondary); }
/* 以下为 auth.tagBadgeClass 返回的标签状态色（拨打结果） */
.badge-green { background: #E1F3D8; color: var(--success); }
.badge-gray { background: #EEEFF3; color: var(--text-sub); }
.badge-blue { background: #E8F0FE; color: var(--info); }
.badge-orange { background: #FAECD8; color: var(--warning); }
.badge-red { background: #FDE2E2; color: var(--danger); }
.badge-default { background: #EEEFF3; color: var(--text-sub); }

/* ---------- 按钮 ---------- */
.btn {
  width: 100%;
  height: 96rpx;
  border-radius: 48rpx;
  background: var(--primary);
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(255, 107, 157, 0.25);
  line-height: 1;
  letter-spacing: 2rpx;
}
.btn::after { border: none; }
.btn:active { opacity: 0.9; transform: scale(0.98); }

.btn-ghost {
  background: #FFF0F5;
  color: var(--primary);
  border: 2rpx solid #FFD0E0;
  box-shadow: none;
}
.btn-danger {
  background: var(--danger);
  box-shadow: 0 8rpx 24rpx rgba(245, 108, 108, 0.25);
}
.btn-secondary {
  background: #fff;
  color: var(--primary);
  border: 2rpx solid #FFC2D7;
  box-shadow: none;
}
.btn-sm {
  width: auto;
  height: auto;
  padding: 16rpx 28rpx;
  font-size: 26rpx;
  display: inline-flex;
  border-radius: 40rpx;
}
.btn-row {
  display: flex;
  gap: 20rpx;
  margin-top: 24rpx;
}
.btn-row .btn { flex: 1; margin: 0; }

/* ---------- 输入框 ---------- */
.input,
.form-input input,
.modal input {
  width: 100%;
  height: 96rpx;
  border-radius: 24rpx;
  border: 2rpx solid var(--border);
  padding: 0 32rpx;
  font-size: 30rpx;
  box-sizing: border-box;
  background: #fff;
  color: var(--text);
  outline: none;
}
.input:focus,
.form-input input:focus,
.modal input:focus { border-color: var(--primary); }
.input::placeholder,
.form-input input::placeholder,
.modal input::placeholder { color: #B5B0C5; }

/* ---------- 表单行 ---------- */
.form-row {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}
.form-label {
  width: 160rpx;
  font-size: 26rpx;
  color: var(--text-sub);
  flex-shrink: 0;
}
.form-input { flex: 1; min-width: 0; }

/* ---------- 弹窗 ---------- */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  inset: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
}
.modal {
  width: 100%;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 40rpx 32rpx 60rpx;
  max-height: 80vh;
  overflow-y: auto;
  box-sizing: border-box;
  padding-bottom: calc(60rpx + env(safe-area-inset-bottom));
}
.modal-title {
  font-size: 36rpx;
  font-weight: 700;
  text-align: center;
  margin-bottom: 32rpx;
  color: var(--text);
}
.modal-section { margin-bottom: 28rpx; }
.modal-label {
  font-size: 26rpx;
  color: var(--text-sub);
  margin-bottom: 16rpx;
}

/* ---------- 备注输入 ---------- */
.note-input {
  width: 100%;
  min-height: 180rpx;
  border: 2rpx solid var(--border);
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  outline: none;
  font-family: inherit;
  background: #fff;
  color: var(--text);
  line-height: 1.5;
}
.note-input:focus { border-color: var(--primary); }

/* ---------- 开关 ---------- */
.switch { display: inline-flex; align-items: center; cursor: pointer; }
.switch-track {
  width: 88rpx;
  height: 48rpx;
  background: #E0DAE8;
  border-radius: 24rpx;
  position: relative;
  transition: background 0.2s;
}
.switch-track::after {
  content: '';
  position: absolute;
  top: 4rpx;
  left: 4rpx;
  width: 40rpx;
  height: 40rpx;
  background: #fff;
  border-radius: 50%;
  transition: left 0.2s;
  box-shadow: 0 4rpx 8rpx rgba(0, 0, 0, 0.15);
}
.switch.on .switch-track { background: var(--primary); }
.switch.on .switch-track::after { left: 44rpx; }
.switch-label { margin-left: 16rpx; font-size: 26rpx; }

/* ---------- 列表项 ---------- */
.list-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 1rpx solid var(--border);
}
.list-item:last-child { border-bottom: none; }
.list-item .name { font-weight: 500; font-size: 30rpx; color: var(--text); }
.list-item .desc { font-size: 24rpx; color: var(--text-sub); margin-top: 6rpx; }

/* ---------- 空状态 ---------- */
.empty {
  text-align: center;
  padding: 80rpx 40rpx;
  color: var(--text-sub);
}
.empty .icon { font-size: 88rpx; margin-bottom: 20rpx; opacity: 0.45; }
.empty .hint { font-size: 24rpx; margin-top: 12rpx; opacity: 0.85; }
.empty .btn-row { margin-top: 32rpx; }

/* ---------- 图标按钮（圆形） ---------- */
.icon-btn {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: #fff;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.1);
  font-size: 48rpx;
  color: var(--primary);
  border: none;
  padding: 0;
  line-height: 1.2;
}
.icon-btn text { font-size: 20rpx; display: block; margin-top: 4rpx; }
.icon-btn.secondary { background: rgba(255, 255, 255, 0.25); color: #fff; }

/* ---------- 号码大卡片 ---------- */
.phone-card {
  background: linear-gradient(135deg, #FF6B9D, #C99BFF);
  border-radius: 40rpx;
  padding: 60rpx 40rpx;
  text-align: center;
  color: #fff;
  box-shadow: 0 12rpx 40rpx rgba(255, 107, 157, 0.35);
  margin-bottom: 24rpx;
}
.phone-card .label-top {
  font-size: 26rpx;
  opacity: 0.92;
  letter-spacing: 2rpx;
}
.phone-card .number {
  font-size: 72rpx;
  font-weight: 700;
  letter-spacing: 6rpx;
  font-family: "SF Mono", Consolas, monospace;
  margin: 24rpx 0;
}
.phone-card .hint { font-size: 22rpx; opacity: 0.85; }
.phone-card .meta {
  display: flex;
  justify-content: center;
  gap: 16rpx;
  margin: 24rpx 0;
  flex-wrap: wrap;
}
.phone-card .pill {
  background: rgba(255, 255, 255, 0.25);
  padding: 10rpx 24rpx;
  border-radius: 24rpx;
  font-size: 24rpx;
  backdrop-filter: blur(10rpx);
  -webkit-backdrop-filter: blur(10rpx);
}
.phone-card .actions {
  display: flex;
  justify-content: center;
  gap: 48rpx;
  margin-top: 16rpx;
}

/* ---------- 进度条（全局默认：浅色轨道，用于白底卡片） ---------- */
.progress-bar {
  height: 12rpx;
  background: #F0EDF2;
  border-radius: 6rpx;
  overflow: hidden;
}
.progress-bar .fill {
  height: 100%;
  background: var(--gradient);
  border-radius: 6rpx;
  transition: width 0.3s;
}
/* 顶部导航条内的进度条：白色半透明轨道 + 白色填充（贴合渐变背景） */
.header-bar .progress-bar {
  background: rgba(255, 255, 255, 0.3);
}
.header-bar .progress-bar .fill {
  background: #fff;
}

/* ---------- 分割线 ---------- */
.divider { height: 1rpx; background: var(--border); margin: 24rpx 0; }

/* ---------- 弹性工具 ---------- */
.flex { display: flex; }
.flex-1 { flex: 1; min-width: 0; }
.flex-center { display: flex; align-items: center; justify-content: center; }
.flex-between { display: flex; align-items: center; justify-content: space-between; }
.gap-sm { gap: 12rpx; }
.gap-md { gap: 24rpx; }
.text-ellipsis { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

/* ---------- 邀约员底部 Tab 栏（全局，供 agent 系列页面复用） ---------- */
.agent-tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  display: flex;
  padding: 12rpx 0 calc(12rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 28rpx rgba(0, 0, 0, 0.06);
  z-index: 100;
}
.agent-tab {
  flex: 1;
  text-align: center;
  font-size: 22rpx;
  color: var(--text-sub);
  padding: 8rpx 0;
}
.agent-tab.active { color: var(--primary); }
.agent-tab-icon {
  font-size: 44rpx;
  margin-bottom: 4rpx;
  display: block;
}
.agent-tab-icon-img {
  width: 46rpx;
  height: 46rpx;
  display: block;
  margin: 0 auto 4rpx;
}

/* ---------- 图标图片（全局，替代 emoji 占位图案） ---------- */
/* 标题前小图标 */
.ti {
  width: 40rpx;
  height: 40rpx;
  margin-right: 8rpx;
  vertical-align: -7rpx;
  display: inline-block;
  flex-shrink: 0;
}
/* 白色滤镜版（用于渐变/深色背景上的标题图标） */
.ti-white,
.inl-white,
.icon-btn-img-white {
  filter: brightness(0) invert(1);
}
/* 行内小图标（meta / pill / 备注等） */
.inl-ico {
  width: 26rpx;
  height: 26rpx;
  margin-right: 4rpx;
  vertical-align: -4rpx;
  display: inline-block;
  flex-shrink: 0;
}
/* 圆形图标按钮内图标 */
.icon-btn-img {
  width: 60rpx;
  height: 60rpx;
  display: block;
  flex-shrink: 0;
}
/* 空状态大图 */
.empty-img {
  width: 240rpx;
  height: 240rpx;
  display: block;
  margin: 0 auto 16rpx;
}
/* 搜索框内图标 */
.search-ico {
  width: 30rpx;
  height: 30rpx;
  margin-right: 8rpx;
  flex-shrink: 0;
}
/* 迷你圆形按钮内图标 */
.mini-btn-img {
  width: 36rpx;
  height: 36rpx;
  display: block;
  flex-shrink: 0;
}

/* ---------- 记录卡片（历史 / 收藏 共享） ---------- */
.record-card { padding: 28rpx; }
.record-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 16rpx;
}
.record-head .phone {
  font-size: 44rpx;
  font-weight: 600;
  color: var(--primary);
  font-family: "SF Mono", Consolas, monospace;
  letter-spacing: 2rpx;
}
.record-head .info {
  font-size: 24rpx;
  color: var(--text-sub);
  margin-top: 8rpx;
}
.record-head .tags { margin-top: 14rpx; }
.record-head .tags .badge { margin-bottom: 6rpx; }
.record-head .btns {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  flex-shrink: 0;
}
.mini-btn {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #FFF0F5;
  color: var(--primary);
  border: none;
  font-size: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(255, 107, 157, 0.15);
}
.mini-btn:active { opacity: 0.8; }
.note-preview {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--text-sub);
  padding: 10rpx 16rpx;
  background: #FAFAFC;
  border-radius: 12rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.record-expand {
  background: #FAFAFC;
  border-radius: 24rpx;
  padding: 24rpx;
  margin-top: 24rpx;
}
.record-expand .note-label {
  font-size: 24rpx;
  color: var(--text-sub);
  margin-bottom: 12rpx;
}
.record-expand .note-text {
  font-size: 26rpx;
  color: var(--text);
  white-space: pre-wrap;
  line-height: 1.6;
}
.record-expand .note-empty {
  color: #BBB;
  font-size: 26rpx;
}
.record-expand .actions {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
  flex-wrap: wrap;
}
.record-expand .actions .btn {
  flex: 1;
  min-width: 160rpx;
}

/* ---------- 补充工具类（login / admin-tags / batch-detail 等页面需要） ---------- */
.btn-primary {
  background: linear-gradient(135deg, #FF6B9D 0%, #9B7EDE 100%);
  color: #fff;
  border: none;
  border-radius: 44rpx;
  font-size: 28rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.btn-outline {
  border: 2rpx solid var(--primary);
  color: var(--primary);
  background: transparent;
  border-radius: 44rpx;
  font-size: 28rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.safe-bottom {
  height: env(safe-area-inset-bottom);
  min-height: 40rpx;
}
